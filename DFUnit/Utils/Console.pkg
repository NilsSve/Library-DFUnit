Use Windows.pkg

{ Visibility=Private }
External_Function DFUnit_WinAPI_TerminateProcess "TerminateProcess" Kernel32.dll Handle hProcess Integer iExitCode Returns Integer

// A unit-test build runner only needs to emit its results and return an exit
// code, then die. ExitProcess runs DLL_PROCESS_DETACH for every loaded DLL;
// with the heavy COM/ActiveX UI a host app may instantiate (e.g. CodeJock
// command bars, Scintilla) that teardown can deadlock and the process then
// never ends - breaking unattended/CI runs. TerminateProcess ends the process
// immediately, skips DLL detach so it cannot deadlock, and still sets the exit
// code. Console output is already flushed (WriteConsoleW is synchronous).
//
// -1 is the documented pseudo-handle for the current process (the value
// GetCurrentProcess() returns). It is passed directly so we avoid an
// unreliable zero-argument external call and any x64 handle round-tripping.
Procedure DFUnit_ConsoleExit Global Integer iOptExitCode
    Integer iVoid iExitCode
    Move 0 to iExitCode
    If (num_arguments > 0) ;
        Move iOptExitCode to iExitCode
    Move (DFUnit_WinAPI_TerminateProcess(-1, iExitCode)) to iVoid
End_Procedure

{ Visibility=Private }
External_Function DFUnit_WinAPI_AttachConsole "AttachConsole" Kernel32.dll ;
    Integer dwProcessID ;
    Returns Integer

{ Visibility=Private }
External_Function DFUnit_WinAPI_GetStdHandle "GetStdHandle" Kernel32.dll ;
    Integer nStdHandle ;
    Returns Integer

{ Visibility=Private }
Global_Variable Handle ghDFUnitConsoleHandle
Move (DFUnit_WinAPI_AttachConsole(-1)) to ghDFUnitConsoleHandle // -1 == ATTACH_PARENT_PROCESS
Move (DFUnit_WinAPI_GetStdHandle(-11)) to ghDFUnitConsoleHandle // -11 == STD_OUTPUT_HANDLE

{ Visibility=Private }
#IF (!@ > 191)
External_Function DFUnit_WinAPI_WriteConsole "WriteConsoleW" Kernel32.dll ;
    Handle hConsole ;
    WString lwpBuffer ;
    DWord nCharsToWrite ;
    Pointer lpnCharsWritten ;
    Pointer lpReserved ;
    Returns Integer
#ELSE 
// ToDo: Create code for earlier versions
External_Function DFUnit_WinAPI_WriteConsole "WriteConsole" Kernel32.dll ;
    Handle hConsole ;
    String lwpBuffer ;
    DWord nCharsToWrite ;
    Pointer lpnCharsWritten ;
    Pointer lpReserved ;
    Returns Integer
#ENDIF

{ Visibility=Private }
#IF (!@ > 191)
Procedure DFUnit_ConsoleWrite Global String sText
    Integer iStatus
    WString wsText
    Move sText to wsText
    Move (DFUnit_WinAPI_WriteConsole(ghDFUnitConsoleHandle, wsText, SizeOfWString(wsText), 0, 0)) to iStatus
End_Procedure
#ELSE 
// ToDo: Create code for earlier versions
Procedure DFUnit_ConsoleWrite Global String sText
    Integer iStatus
End_Procedure
#ENDIF

{ Visibility=Private }
Procedure DFUnit_ConsoleWriteLn Global String sText
    Send DFUnit_ConsoleWrite (sText+(Character(10))+(Character(13)))
End_Procedure