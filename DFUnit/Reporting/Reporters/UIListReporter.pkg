Use cRichEdit.pkg
#IFNDEF clEditorBackGround
    Define clEditorBackGround for (RGB(36, 49, 68)) // HTML 243144
#ENDIF

Use DFUnit\Reporting\LineBasedReporting.pkg

Class cDFUnitUIListInmediateReporter is a cRichEdit
        
    Import_Class_Protocol cDFUnitLineBasedReporter_Mixin
    Import_Class_Protocol IReporter_Mixin cDFUnitUIListInmediateReporter All No_Overwrite
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Send HideSelection True 
        // It is very handy to be able to copy text from the output:
//        Set Focus_Mode to NonFocusable
//        Set Read_Only_State to False
//        Set Color to clWhite

        Set Color to clEditorBackGround   
        Set TextColor to clWhite    
        Send Define_cDFUnitLineBasedReporter_Mixin 
        // Set to  a fix typeface & a larger font size to make it easier to read.
        Set psTypeFace to "Cascadia Mono"
        // Set fontsize to 11 (* 20 twips) 
        Set piFontSize to (11 * 20)
    End_Procedure
    
    Procedure Set Color Integer iColor
        Forward Set Color to iColor
    End_Procedure
    
    Procedure Start Handle hEnv
        Send Select_All
        Send Delete
//        Set Color to clGray  
        Set Color to clEditorBackGround
    End_Procedure
    
    { Visibility=Private }
    Procedure Print String sLine
        String sIndentation
        
        Get ScopeIndentation to sIndentation
        Send AppendText (sIndentation + sLine)
        Set pbNewLine to False
    End_Procedure
    
    { Visibility=Private }
    Procedure PrintLn String sLine
        String sIndentation
        
        Get ScopeIndentation to sIndentation
        Send AppendTextLn (sIndentation + sLine)
        Set pbNewLine to True
    End_Procedure
    
    { Visibility=Private }
    Procedure Line
        If (pbNewLine(Self) = False) ;
            Send PrintLn ""
        Send AppendTextLn (psLine(Self))
    End_Procedure
    
End_Class

Class cDFUnitUIListReporter is a cDFUnitUIListInmediateReporter
    
    Procedure Construct_Object
        Forward Send Construct_Object

        { Visibility=Private }
        Property String[] paMessages
        Property Integer piLineNumber 1
        // When True, Print emits no line-number prefix and does NOT advance the
        // counter. Set during Finish so the summary block (Assertions / Tests /
        // Failures / Errors and the trailing Tests: Succeeded!/Failure line)
        // appears flush without a number, and the counter doesn't show gaps.
        Property Boolean pbSuppressLineNumber False
        // Where the line found last by FindNextError ends; 0 = search from the caret.
        Property Integer piLastErrorEnd 0
        // True: each line is written as soon as it is finished, so the output fills while the tests run (the window
        // that shows it may paint after each line). False: all lines are written when the run is finished.
        Property Boolean pbShowLinesAsTheyCome False

        On_Key Key_F3          Send FindNextError
        On_Key Key_Ctrl+Key_N  Send FindNextError
    End_Procedure
    
    Procedure Start Handle hEnv
        String[] aMessages
        
        Set piLineNumber to 1
        Set piLastErrorEnd to 0
        Forward Send Start      
        // This will set the array to zero for each run:
        Move "" to aMessages[SizeOfArray(aMessages)]
        Set paMessages to aMessages
    End_Procedure
    
    Procedure Finish Handle hEnv
        Integer iIterator iMaxIndex
        String[] aMessages

        // Suppress line-number prefixing for the whole summary block printed
        // by the base-class Finish (Assertions / Tests / Failures / Errors
        // and the trailing status line). Reset right after so any post-Finish
        // output - none today, but future-proof - resumes normal numbering.
        Set pbSuppressLineNumber to True
        Forward Send Finish hEnv
        Set pbSuppressLineNumber to False
        // Written as they came: nothing is left to write.
        If (pbShowLinesAsTheyCome(Self)) Begin
            Procedure_Return
        End
        Get paMessages to aMessages
        // Minus the last empty entry.
        Move (SizeOfArray(aMessages) - 1 - 1) to iMaxIndex
        For iIterator from 0 to iMaxIndex
            Send WriteOutputLine aMessages[iIterator]
        Loop
    End_Procedure

    // Writes one finished line to the box. The line of a failed test gets the line its procedure starts on in the
    // test source, and a red background.
    { Visibility=Private }
    Procedure WriteOutputLine String sMessage
        Integer iRow iPos

        If (Lowercase(sMessage) contains Lowercase(CS_FailedClause)) Begin
            Get UnitTestFileLineNumber of ghoTestApplication sMessage to iRow
            If (iRow <> -1) Begin
                Move (Pos("]", sMessage)) to iPos
                If (iPos <> 0) Begin
                    Append sMessage " In procedure starting on line: " iRow
                End
            End
            Set TextBackColor to clRed
        End
        Else Begin
            Set TextBackColor to clEditorBackGround
        End
        Send AppendTextLn sMessage
    End_Procedure

    // A line is finished: with pbShowLinesAsTheyCome it is written now, the box shows the end, and the window may
    // paint (and answer the mouse) before the next test runs.
    { Visibility=Private }
    Procedure LineFinished String sMessage
        If (pbShowLinesAsTheyCome(Self) = False) Begin
            Procedure_Return
        End
        Send WriteOutputLine sMessage
        Send End_of_Data
        Send PumpMsgQueue of Desktop
    End_Procedure

    // Selects the next line of a failed test (CS_FailedClause) after the one found last; after the last one it
    // starts from the top again. FindText searches on from the caret (its second argument is a flag), so the
    // caret is first put behind the line found last - else the same line would be found again.
    Procedure FindNextError
        Integer iStart iEnd
        String sSearchText

        Move CS_FailedClause to sSearchText
        Get piLastErrorEnd to iEnd
        If (iEnd > 0) Begin
            Send SetSel iEnd iEnd
        End
        Get FindText sSearchText 0 to iStart
        If (iStart = -1) Begin
            Send Beginning_of_Data
            Get FindText sSearchText 0 to iStart
        End
        If (iStart <> -1) Begin
            Move (iStart + Length(sSearchText)) to iEnd
            Send SetSel iStart iEnd
            Set piLastErrorEnd to iEnd
        End
    End_Procedure

    // Returns a four "digit" string line number with the format: 0001 to 9999
    // Pad string with up to 3 zeroes, depending on the size of iLineNumber
    Function PadStringWithZeroes Integer iLineNumber Returns String
        String sRetval
        Move (FillString("0", (4 - Length(iLineNumber)))) to sRetval
        Append sRetval iLineNumber
        Function_Return sRetval
    End_Function
    
    { Visibility=Private }
    Procedure Print String sLine
        String sIndentation sLineNumber
        String[] aMessages
        Integer iLineNumber
        Boolean bSuppress

        Get pbSuppressLineNumber to bSuppress
        Get ScopeIndentation to sIndentation
        Get paMessages to aMessages

        If (pbNewLine(Self) = True) Begin
            If (bSuppress = True) Begin
                // Summary block - no line-number prefix, no counter advance.
                Move (String(sIndentation) + sLine) to aMessages[SizeOfArray(aMessages) - 1]
            End
            Else Begin
                Get piLineNumber to iLineNumber
                Get PadStringWithZeroes iLineNumber to sLineNumber
                Increment iLineNumber
                Set piLineNumber to iLineNumber
                Move (sLineNumber + "  " + String(sIndentation) + sLine) to aMessages[SizeOfArray(aMessages) - 1]
                // This removes the "at line number" comment, so don't use for now
//                Move (String(SizeOfArray(aMessages)) + " " + String(sIndentation) + sLine) to aMessages[SizeOfArray(aMessages) - 1]
            End
        End
        Else Begin
            Move (aMessages[SizeOfArray(aMessages) - 1] + sLine) to aMessages[SizeOfArray(aMessages) - 1]
        End

        Set paMessages to aMessages
        Set pbNewLine to False
    End_Procedure
    
    { Visibility=Private }
    Procedure PrintLn String sLine
        String[] aMessages
        
        Send Print sLine
        Get paMessages to aMessages
        Send LineFinished aMessages[SizeOfArray(aMessages) - 1]
        Move "" to aMessages[SizeOfArray(aMessages)]
        Set paMessages to aMessages
        Set pbNewLine to True
    End_Procedure
    
    { Visibility=Private }
    Procedure Line
        String[] aMessages
        
        If (pbNewLine(Self) = False) ;
            Send PrintLn ""
        Get paMessages to aMessages
        Move (psLine(Self)) to aMessages[SizeOfArray(aMessages) - 1]
        Send LineFinished aMessages[SizeOfArray(aMessages) - 1]
        Move "" to aMessages[SizeOfArray(aMessages)]
        Set paMessages to aMessages
    End_Procedure
    
End_Class
