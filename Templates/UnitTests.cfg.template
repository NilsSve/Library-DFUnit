; UnitTests.cfg - project settings for the DFUnit test program.
;
; Platform=x64 makes a command-line build produce UnitTests64.exe rather than silently
; falling back to 32-bit.
; The manifest is off: df-cli does not write one, and with these two on a build on a build
; server stops with "manifest file cannot be found". Without it Windows gives the program the
; old common controls, and the buttons of the test-runner window show their text only. A
; program built in the Studio can have them on (the Studio writes the manifest).
; Icon is the icon of the program file. The test-runner window brings its own images.
[Application]
IsWebApp=0
BuildManifestFile=0
EmbedManifestFile=0
DPIAware=1
AutoGenerateMenus=0
CompilerWarnings=1
Icon=UnitTesting.ico
[Compiler]
Platform=x64
64BitSuffix=64
32BitSuffix=
BeforeCompileProcessEnabled=0
AfterCompileProcessEnabled=0
[Version]
Include=0
AutoIncrementBuild=0
